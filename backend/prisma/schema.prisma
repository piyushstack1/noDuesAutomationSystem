generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Status enums
enum RequestStatus {
  PENDING
  PROGRESS
  APPROVED
  REJECTED
  CANCELLED
}

enum QueryStatus {
  PENDING
  PROGRESS
  RESOLVED
  CANCELLED
}

enum DegreeType {
  BTECH
  MTECH
  PHD
  MSC
  MCA
  MBA
  BARCH
}

enum UnitType {
  DEPARTMENT
  HOSTEL
  LIBRARY
  ACCOUNTS
  SPORTS
  PROCTOR
  NCC
}


model Department {
  name            String
  department_code String    @id
  head            String
  students        Student[]
}

model Hostel {
  name      String
  hostel_no String    @id
  warden    String?
  students  Student[]
}

model CentralUnit {
  unit_id   Int    @id @default(autoincrement())
  unit_type UnitType @unique
}

model Admin {
  admin_id  Int             @id @default(autoincrement())
  name      String
  email     String          @unique
  password  String
  approvals FinalApproval[]
  requests  NoDuesRequest[]
}

model Student {
  student_id      String         @id
  name            String
  email           String         @unique
  course          String
  admission_date  DateTime
  department_code String?
  hostel_no       String?
  passing_date    DateTime?
  password        String
  request_id      Int?           @unique
  aadhar_passport String
  address         String
  bank_account_no String
  branch          String
  cgpa            Float
  degree          String
  department      String
  documents       Json
  ifsc_code       String
  is_hosteler     Boolean        @default(true)
  mobile_no       String
  profile_picture String
  room_no         String?
  scholar_no      String         @unique
  request         NoDuesRequest?
  queries         Query[]
  department_rel  Department?    @relation(fields: [department_code], references: [department_code])
  hostel          Hostel?        @relation(fields: [hostel_no], references: [hostel_no])

  @@index([scholar_no])
  @@index([email])
}

model Staff {
  staff_id  Int     @id @default(autoincrement())
  name      String
  email     String
  password  String
  unit_type UnitType
  unit_id   String?
  tracks    Track[]
}

model NoDuesRequest {
  request_id          Int            @id @default(autoincrement())
  status              RequestStatus  @default(PENDING)
  submitted_at        DateTime       @default(now())
  student_id          String         @unique
  admin_id            Int
  accounts_approval   Boolean        @default(false)
  completed_at        DateTime?
  department_approval Boolean        @default(false)
  hostel_approval     Boolean        @default(false)
  last_updated_at     DateTime       @updatedAt
  library_approval    Boolean        @default(false)
  proctor_approval    Boolean        @default(false)
  ncc_approval        Boolean        @default(false)
  reason              String?
  remarks             String?
  required_docs       Json
  sports_approval     Boolean        @default(false)
  submitted_docs      Json
  final               FinalApproval?
  admin               Admin          @relation(fields: [admin_id], references: [admin_id])
  student             Student        @relation(fields: [student_id], references: [student_id])
  queries             Query[]
  tracks              Track[]

  @@index([status])
  @@index([submitted_at])
}

model Query {
  query_id       Int           @id @default(autoincrement())
  student_id     String
  request_id     Int
  track_id       Int?
  approving_unit String
  remarks        String
  status         QueryStatus   @default(PENDING)
  created_at     DateTime      @default(now())
  resolved_at    DateTime?
  request        NoDuesRequest @relation(fields: [request_id], references: [request_id])
  student        Student       @relation(fields: [student_id], references: [student_id])
  track          Track?        @relation(fields: [track_id], references: [track_id])
}

model Track {
  track_id    Int           @id @default(autoincrement())
  unit_id     String?
  remarks     String?
  updated_at  DateTime      @default(now())
  request_id  Int
  staff_id    Int?
  step_number Int
  unit_type   UnitType
  status      RequestStatus @default(PENDING)
  queries     Query[]
  request     NoDuesRequest @relation(fields: [request_id], references: [request_id])
  staff       Staff?        @relation(fields: [staff_id], references: [staff_id])
}

model FinalApproval {
  approval_id  Int           @id @default(autoincrement())
  admin_id     Int
  issued_at    DateTime      @default(now())
  request_id   Int           @unique
  final_status RequestStatus @default(PENDING)
  admin        Admin         @relation(fields: [admin_id], references: [admin_id])
  request      NoDuesRequest @relation(fields: [request_id], references: [request_id])
}
